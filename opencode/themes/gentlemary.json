{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "red":         "#af4a67",
    "green":       "#3da676",
    "blue":        "#4b95dc",
    "purple":      "#a576a0",
    "yellow":      "#ccb385",
    "cyan":        "#66bbcc",
    "orange":      "#cc7832",
    "grey":        "#777777",
    "greyPunct":   "#8a8a8a",
    "white":       "#eeeeee",
    "fg":          "#dddddd",
    "bg":          "#0d0f0f",
    "bgPanel":     "#161818",
    "bgElement":   "#232525",
    "border":      "#444444",
    "borderSubtle": "#333333",
    "lineNr":      "#585858",
    "errorRed":    "#d21e29",
    "diffAddBg":   "#16261c",
    "diffRemBg":   "#2b1a20",
    "diffHighlightAdded":   "#6fd9a0",
    "diffHighlightRemoved": "#ff6b81",

    "redLight":       "#8c3b52",
    "greenLight":     "#348d64",
    "blueLight":      "#407fbb",
    "purpleLight":    "#735370",
    "yellowLight":    "#706249",
    "cyanLight":      "#427a85",
    "orangeLight":    "#b86c2d",
    "greyLight":      "#767676",
    "greyPunctLight": "#707070",
    "whiteLight":     "#000000",
    "fgLight":        "#1a1a1a",
    "bgLight":        "#fafafa",
    "bgPanelLight":   "#f0f0ee",
    "bgElementLight": "#e5e5e3",
    "borderLight":       "#bbbbbb",
    "borderSubtleLight": "#dddddd",
    "lineNrLight":    "#999999",
    "errorRedLight":  "#bd1b25",
    "diffAddBgLight": "#d9ecd9",
    "diffRemBgLight": "#f6dde1",
    "diffHighlightAddedLight":   "#1f7a4d",
    "diffHighlightRemovedLight": "#b3213a"
  },
  "theme": {
    "primary":   { "dark": "green",    "light": "greenLight" },
    "secondary": { "dark": "blue",     "light": "blueLight" },
    "accent":    { "dark": "orange",   "light": "orangeLight" },
    "error":     { "dark": "errorRed", "light": "errorRedLight" },
    "warning":   { "dark": "yellow",   "light": "yellowLight" },
    "success":   { "dark": "green",    "light": "greenLight" },
    "info":      { "dark": "blue",     "light": "blueLight" },

    "text":      { "dark": "fg",   "light": "fgLight" },
    "textMuted": { "dark": "grey", "light": "greyLight" },

    "background":        { "dark": "bg",        "light": "bgLight" },
    "backgroundPanel":   { "dark": "bgPanel",    "light": "bgPanelLight" },
    "backgroundElement": { "dark": "bgElement",  "light": "bgElementLight" },

    "border":       { "dark": "border",       "light": "borderLight" },
    "borderActive": { "dark": "fg",           "light": "fgLight" },
    "borderSubtle": { "dark": "borderSubtle", "light": "borderSubtleLight" },

    "diffAdded":            { "dark": "green",               "light": "greenLight" },
    "diffRemoved":          { "dark": "red",                 "light": "redLight" },
    "diffContext":          { "dark": "grey",                "light": "greyLight" },
    "diffHunkHeader":       { "dark": "purple",               "light": "purpleLight" },
    "diffHighlightAdded":   { "dark": "diffHighlightAdded",   "light": "diffHighlightAddedLight" },
    "diffHighlightRemoved": { "dark": "diffHighlightRemoved", "light": "diffHighlightRemovedLight" },
    "diffAddedBg":          { "dark": "diffAddBg",  "light": "diffAddBgLight" },
    "diffRemovedBg":        { "dark": "diffRemBg",  "light": "diffRemBgLight" },
    "diffContextBg":        { "dark": "bgPanel",    "light": "bgPanelLight" },
    "diffLineNumber":       { "dark": "lineNr",     "light": "lineNrLight" },
    "diffAddedLineNumberBg":   { "dark": "diffAddBg", "light": "diffAddBgLight" },
    "diffRemovedLineNumberBg": { "dark": "diffRemBg", "light": "diffRemBgLight" },

    "markdownText":           { "dark": "fg",    "light": "fgLight" },
    "markdownHeading":        { "dark": "green", "light": "greenLight" },
    "markdownLink":           { "dark": "blue",  "light": "blueLight" },
    "markdownLinkText":       { "dark": "purple", "light": "purpleLight" },
    "markdownCode":           { "dark": "grey",  "light": "greyLight" },
    "markdownCodeBlock":      { "dark": "grey",  "light": "greyLight" },
    "markdownBlockQuote":     { "dark": "yellow", "light": "yellowLight" },
    "markdownEmph":           { "dark": "red",    "light": "redLight" },
    "markdownStrong":         { "dark": "purple", "light": "purpleLight" },
    "markdownHorizontalRule": { "dark": "grey",  "light": "greyLight" },
    "markdownListItem":        { "dark": "fg", "light": "fgLight" },
    "markdownListEnumeration": { "dark": "fg", "light": "fgLight" },
    "markdownImage":     { "dark": "blue",   "light": "blueLight" },
    "markdownImageText": { "dark": "purple", "light": "purpleLight" },

    "syntaxComment":     { "dark": "grey",      "light": "greyLight" },
    "syntaxKeyword":     { "dark": "red",       "light": "redLight" },
    "syntaxFunction":    { "dark": "green",     "light": "greenLight" },
    "syntaxVariable":    { "dark": "blue",      "light": "blueLight" },
    "syntaxString":      { "dark": "yellow",    "light": "yellowLight" },
    "syntaxNumber":      { "dark": "cyan",      "light": "cyanLight" },
    "syntaxType":        { "dark": "purple",    "light": "purpleLight" },
    "syntaxOperator":    { "dark": "fg",        "light": "fgLight" },
    "syntaxPunctuation": { "dark": "greyPunct", "light": "greyPunctLight" }
  }
}
